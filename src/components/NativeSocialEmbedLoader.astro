<script>
  const videoId = (url: string) => {
    const parsed = new URL(url);
    if (parsed.hostname.includes('youtu.be')) return parsed.pathname.slice(1);
    if (parsed.pathname.startsWith('/shorts/')) return parsed.pathname.split('/')[2];
    return parsed.searchParams.get('v');
  };

  const instagramEmbedUrl = (url: string) => {
    const parsed = new URL(url);
    const match = parsed.pathname.match(/\/(p|reel)\/([^/]+)/);
    if (!match) throw new Error('Unsupported Instagram URL.');
    return `https://www.instagram.com/${match[1]}/${match[2]}/`;
  };

  const showFallback = (stage: HTMLElement, url: string, label: string) => {
    stage.replaceChildren();
    const message = document.createElement('p');
    message.append('The native post could not load. ');
    const link = document.createElement('a');
    link.href = url;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.textContent = `Open it on ${label} ↗`;
    message.append(link);
    stage.append(message);
  };

  const renderPost = async (root: HTMLElement, platform: string, url: string) => {
    const stage = root.querySelector<HTMLElement>('[data-native-stage]');
    if (!stage) return;
    const label = platform.charAt(0).toUpperCase() + platform.slice(1);
    stage.replaceChildren();
    stage.classList.add('native-social__stage--loading');
    const loading = document.createElement('p');
    loading.textContent = `Loading the post from ${label}…`;
    stage.append(loading);

    try {
      if (platform === 'youtube') {
        const id = videoId(url);
        if (!id) throw new Error('Unsupported YouTube URL.');
        const frame = document.createElement('iframe');
        frame.className = 'native-social__frame native-social__frame--video';
        frame.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}`;
        frame.title = 'Manhood Applied video on YouTube';
        frame.loading = 'lazy';
        frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        frame.allowFullscreen = true;
        stage.replaceChildren(frame);
      } else if (platform === 'tiktok') {
        const id = new URL(url).pathname.match(/\/video\/(\d+)/)?.[1];
        if (!id) throw new Error('Unsupported TikTok URL.');
        const frame = document.createElement('iframe');
        frame.className = 'native-social__frame native-social__frame--video';
        frame.src = `https://www.tiktok.com/player/v1/${encodeURIComponent(id)}?autoplay=0&loop=0`;
        frame.title = 'Manhood Applied video on TikTok';
        frame.loading = 'lazy';
        frame.allow = 'fullscreen';
        frame.allowFullscreen = true;
        stage.replaceChildren(frame);
      } else if (platform === 'instagram') {
        const frame = document.createElement('iframe');
        frame.className = 'instagram-media';
        frame.src = `${instagramEmbedUrl(url)}embed/`;
        frame.title = 'Manhood Applied post on Instagram';
        frame.loading = 'lazy';
        frame.setAttribute('scrolling', 'no');
        frame.allowFullscreen = true;
        stage.replaceChildren(frame);
      } else {
        throw new Error('Unsupported platform.');
      }
      stage.classList.remove('native-social__stage--loading');
    } catch {
      stage.classList.remove('native-social__stage--loading');
      showFallback(stage, url, label);
    }
  };

  document.querySelectorAll<HTMLElement>('[data-native-social]').forEach((root) => {
    let loaded = false;
    const loadDefault = () => {
      if (loaded || !root.dataset.defaultPlatform || !root.dataset.defaultUrl) return;
      loaded = true;
      void renderPost(root, root.dataset.defaultPlatform, root.dataset.defaultUrl);
    };

    root.querySelectorAll<HTMLButtonElement>('[data-select-platform]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!button.dataset.selectPlatform || !button.dataset.url) return;
        loaded = true;
        root.querySelectorAll<HTMLButtonElement>('[data-select-platform]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        void renderPost(root, button.dataset.selectPlatform, button.dataset.url);
      });
    });

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer.disconnect();
          loadDefault();
        }
      }, { rootMargin: '500px 0px' });
      observer.observe(root);
    } else {
      loadDefault();
    }
  });
</script>
