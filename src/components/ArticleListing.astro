---
import ArticleCard from './ArticleCard.astro';
import type { Article } from '../utils/content';

interface Props {
  title: string;
  articles: Article[];
}

const { title, articles } = Astro.props;
---

<h1 class="visually-hidden" id="listing-title">{title}</h1>
<section class="section listing-section" aria-labelledby="listing-title">
  <div class="listing-count"><span>{articles.length}</span> published {articles.length === 1 ? 'entry' : 'entries'}</div>
  <div class="article-grid">{articles.map((article, index) => <ArticleCard article={article} index={index + 1} />)}</div>
</section>
