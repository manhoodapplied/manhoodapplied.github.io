---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SocialPostGallery from '../../components/SocialPostGallery.astro';
import { getPublishedArticles, getPublishedSocialPosts } from '../../utils/content';
const articles = await getPublishedArticles();
const posts = (await getPublishedSocialPosts()).filter((post) => post.data.contentType === 'carousel');
---
<BaseLayout title="Carousels" description="Browse every published Manhood Applied carousel as a native social post, with optional links to related long-form articles." canonicalPath="/carousels/">
  <SocialPostGallery title="Carousels" posts={posts} articles={articles} />
</BaseLayout>
