---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CATEGORIES } from '../../data/site';
import { getPublishedArticles } from '../../utils/content';
const articles = await getPublishedArticles();
---
<BaseLayout title="Topics" description="Browse Manhood Applied articles across mind, health, work, relationships, character, and discipline." canonicalPath="/topics/">
  <h1 class="visually-hidden" id="topics-title">Topics</h1>
  <section class="section listing-section" aria-labelledby="topics-title"><div class="topic-grid topic-grid--index">{Object.entries(CATEGORIES).map(([slug, category]) => { const count = articles.filter((article) => article.data.category === slug).length; return <a href={`/topics/${slug}/`}><span>{category.number}</span><h2>{category.name}</h2><p>{category.description}</p><i>{count} {count === 1 ? 'article' : 'articles'} →</i></a>; })}</div></section>
</BaseLayout>
