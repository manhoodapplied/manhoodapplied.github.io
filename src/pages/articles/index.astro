---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleListing from '../../components/ArticleListing.astro';
import { getPublishedArticles } from '../../utils/content';
const articles = await getPublishedArticles();
---
<BaseLayout title="Articles" description="Practical, text-led MAPP articles on judgment, health, work, relationships, character, and discipline." canonicalPath="/articles/">
  <ArticleListing title="Articles" articles={articles} />
</BaseLayout>
